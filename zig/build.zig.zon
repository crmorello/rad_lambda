.{
    .name = .rad_lambda,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xb94dc10a7767ccfb,
    .dependencies = .{
        // radcore is THE shared core (raydare §14) — same RAD encode/decode
        // the client renders from. Sibling checkout (github.com/crmorello/radcore
        // at ~/Developer/Zig/radcore); url+hash once it ships as a package.
        .radcore = .{ .path = "../../../../Zig/radcore" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
